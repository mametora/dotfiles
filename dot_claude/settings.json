{
  "permissions": {
    "allow": [
      "mcp__serena__find_file",
      "mcp__serena__list_dir",
      "mcp__serena__search_for_pattern",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__write_memory",
      "mcp__serena__think_about_whether_you_are_done",
      "mcp__serena__think_about_collected_information",
      "mcp__serena__find_symbol",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__read_memory",
      "WebSearch",
      "mcp__serena__think_about_task_adherence",
      "mcp__MCP_DOCKER__pull_request_read",
      "mcp__MCP_DOCKER__list_directory_tree_in_folder",
      "Bash(PYTHONPATH=. poetry run pytest:*)",
      "mcp__chrome-devtools",
      "mcp__jetbrains__list_directory_tree",
      "Bash(grep:*)",
      "mcp__jetbrains__get_file_text_by_path",
      "Bash(ls:*)",
      "mcp__jetbrains__find_files_by_glob",
      "Bash(find:*)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "default"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "serena@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "codex@openai-codex": true,
    "slack@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "using-cmux@hummer98-using-cmux": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "hummer98-using-cmux": {
      "source": {
        "source": "github",
        "repo": "hummer98/using-cmux"
      }
    }
  },
  "language": "Japanese",
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "mcpServers": {
    "MCP_DOCKER": {
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ],
      "env": {}
    },
    "jetbrains": {
      "url": "http://localhost:64343/sse",
      "type": "sse"
    }
  }
}
