set -gx VISUAL "code --wait --new-window"
set -gx EDITOR "code --wait --new-window"
eval (/opt/homebrew/bin/brew shellenv)

# Homebrew vendor configuration runs before this file, so activate mise again
# after brew shellenv has finalized PATH ordering.
if command -q mise
    mise activate fish | source
end

# pnpm
set -gx PNPM_HOME "{{ .chezmoi.homeDir }}/Library/pnpm"

# pnpm commands installed outside mise
fish_add_path --prepend "$PNPM_HOME"

# LM Studio CLI
fish_add_path --append "{{ .chezmoi.homeDir }}/.lmstudio/bin"

# JetBrains Toolbox
fish_add_path --append "$HOME/Library/Application Support/JetBrains/Toolbox/scripts"

# pipx
fish_add_path --append "{{ .chezmoi.homeDir }}/.local/bin"

source {{ .chezmoi.homeDir }}/.config/op/plugins.sh

if status is-interactive
    # Commands to run in interactive sessions can go here
end
